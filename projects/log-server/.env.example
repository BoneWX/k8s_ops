TZ=Asia/Shanghai

# Change these to your intranet image names if they are not tagged as official names.
LOKI_IMAGE=grafana/loki:latest
GRAFANA_IMAGE=grafana/grafana:latest
ALLOY_IMAGE=grafana/alloy:latest
NODE_IMAGE=node:22-alpine

GRAFANA_HTTP_PORT=3000
LOKI_HTTP_PORT=3100
ALLOY_HTTP_PORT=12345
SYSLOG_TCP_PORT=1514
SYSLOG_UDP_PORT=1514
WORKER_HTTP_PORT=18080
WORKER_CORS_ORIGIN=*

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_please

# Directory on the Ubuntu log server that contains exported log files.
# Recommended production layout:
#   /data/logs/network  switch/router/firewall logs
#   /data/logs/<type>   future log categories
# For a quick first test you can temporarily use ./logs.
HOST_LOG_DIR=/data/logs

# Optional: put unsigned Grafana app plugins under ./plugins and list their ids here.
GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS=wx-loganalyzer-app

# Worker source directory. The default package includes ai-log-analyzer-app/worker.
AI_ANALYZER_APP_DIR=./ai-log-analyzer-app
