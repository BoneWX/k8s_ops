# Copy this file to config/worker/auto-analyzer.env and edit it.

# In docker compose, LOKI_BASE_URL is overridden to http://loki:3100.
LOKI_BASE_URL=http://loki:3100

# LiteLLM OpenAI-compatible endpoint. It must include /v1.
LITELLM_BASE_URL=http://192.168.114.144/v1
LITELLM_API_KEY=sk-your-worker-key
LITELLM_MODEL=claude-deepseek-v4-pro-agent
LITELLM_MAX_TOKENS=2400
LITELLM_HEALTH_TIMEOUT_MS=30000
LITELLM_TIMEOUT_MS=120000

# Default rule: analyze automatically classified .log files under /data/logs/<domain>/<type>/.
ANALYZER_RULE_ID=central-file-risk-events
ANALYZER_QUERY={job="central-file-log", log_domain=~".+", log_type=~".+"} |~ "(?i)(fatal|panic|exception|error|fail|failed|deny|denied|timeout|timed out|refused|reset by peer|down|link[ -]?down|interface.*down|updown|flap|mac.*flap|loop|stp|ospf|bgp|isis|attack|blocked|malware|auth|login|logout|threshold|crc|discard|drop|critical|warning|warn|oom|out of memory|deadlock|slow)"
ANALYZER_CONTEXT_QUERY={job="central-file-log", log_domain=~".+", log_type=~".+"}
# Whether context logs are sent to AI and stored in result context_logs by default.
# Per-rule includeContextLogs in auto-analysis-rules.json overrides this.
ANALYZER_INCLUDE_CONTEXT_LOGS=true

ANALYZER_LOOKBACK_MINUTES=5
ANALYZER_CONTEXT_LOOKBACK_MINUTES=30
ANALYZER_INTERVAL_SECONDS=300
ANALYZER_RULE_CONCURRENCY=2
ANALYZER_RULE_TIMEOUT_MS=240000
LOKI_QUERY_TIMEOUT_MS=60000

ANALYZER_MAX_TRIGGER_EVENTS=10
ANALYZER_MAX_CONTEXT_LINES=80
ANALYZER_PROMPT_TRIGGER_SAMPLE_MAX=10
ANALYZER_PROMPT_CONTEXT_SAMPLE_MAX=80
ANALYZER_CONTEXT_AROUND_TRIGGER_MINUTES=5
ANALYZER_MAX_PROMPT_CHARS=24000
ANALYZER_CACHE_PATH=/config/seen-events.json
# Per-rule cursor overlap used to catch boundary/late-arriving Loki entries.
ANALYZER_CURSOR_OVERLAP_SECONDS=60
# When a query page is full, drain all logs sharing the last Loki timestamp.
ANALYZER_SAME_TIMESTAMP_DRAIN_LIMIT=5000
ANALYZER_RULES_PATH=/config/auto-analysis-rules.json

# Analysis result is pushed back to Loki and can be queried by {job="ai-log-analysis"}.
ANALYZER_PUSH_RESULT_TO_LOKI=true
ANALYZER_RESULT_JOB=ai-log-analysis

# Optional alert push. If ANALYZER_ALERT_CONFIG_PATH exists, it overrides the
# simple env fallback below. The default compose mount maps /config to
# ./config/worker on the host.
ANALYZER_ALERT_CONFIG_PATH=/config/alert-config.json
ANALYZER_ALERT_PUSH_ENABLED=false
ANALYZER_ALERT_WEBHOOK_URL=
ANALYZER_ALERT_MIN_SEVERITY=P2
ANALYZER_ALERT_TIMEOUT_MS=10000
ANALYZER_ALERT_TRIGGER_LOG_LIMIT=30

WORKER_API_ENABLED=true
WORKER_API_HOST=0.0.0.0
WORKER_API_PORT=8080
WORKER_CORS_ORIGIN=*
