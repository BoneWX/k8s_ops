# Direct network syslog example. File logs under /data/logs/<domain>/<type>/ use central-file-log instead.

ANALYZER_RULE_ID=network-syslog-events
ANALYZER_QUERY={job="network-syslog"} |~ "(?i)(error|fail|failed|deny|denied|timeout|down|link[ -]?down|interface.*down|updown|flap|mac.*flap|loop|stp|ospf|bgp|isis|attack|blocked|malware|auth|login|logout|threshold|crc|discard|drop|critical|warning|warn)"
ANALYZER_CONTEXT_QUERY={job="network-syslog"}
# Set false for application / behavior syslog where each event should be analyzed alone.
ANALYZER_INCLUDE_CONTEXT_LOGS=true
ANALYZER_LOOKBACK_MINUTES=5
ANALYZER_CONTEXT_LOOKBACK_MINUTES=30
ANALYZER_INTERVAL_SECONDS=300
ANALYZER_MAX_TRIGGER_EVENTS=10
ANALYZER_MAX_CONTEXT_LINES=80
ANALYZER_PROMPT_TRIGGER_SAMPLE_MAX=10
ANALYZER_PROMPT_CONTEXT_SAMPLE_MAX=80
ANALYZER_CONTEXT_AROUND_TRIGGER_MINUTES=5
ANALYZER_MAX_PROMPT_CHARS=24000
