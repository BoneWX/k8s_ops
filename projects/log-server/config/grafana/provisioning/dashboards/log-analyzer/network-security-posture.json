      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"central-file-log\", log_domain=\"network\", log_type=~\"$log_type\"} |~ \"(?i)$search\" [$__range])) or vector(0)",
