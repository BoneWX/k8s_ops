FEISHU_BASE_URL=https://open.feishu.cn

# Option A: let the script fetch tenant_access_token by app credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Option B: provide tenant_access_token directly. If set, app credentials are not used.
FEISHU_TENANT_ACCESS_TOKEN=

# Default query window used when --oldest/--latest are not provided.
FEISHU_LAST_MINUTES=60

# Feishu allows 1-200 for this API.
FEISHU_PAGE_SIZE=100

# user_id_type: open_id | union_id | user_id
FEISHU_USER_ID_TYPE=user_id
